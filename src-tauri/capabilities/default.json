{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the FOCUS by MIMI main window.",
  "windows": ["main"],
  "permissions": [
    "allow-list-profiles", "allow-save-profile-proposal", "allow-approve-profile-version",
    "allow-delete-profile", "allow-set-profile-visible", "allow-set-profile-order",
    "allow-list-projects", "allow-list-tasks", "allow-save-project", "allow-save-task",
    "allow-get-session-status", "allow-start-session", "allow-shorten-session-time",
    "allow-start-session-break", "allow-skip-session-break", "allow-record-session-outcome",
    "allow-simulate-session-policy"
  ]
}
